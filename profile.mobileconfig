<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DNS Profile Download</title>
<style>
    body {
        margin: 0;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle, #000000 60%, #001a33);
        font-family: Arial, sans-serif;
    }

    .panel {
        width: 400px;
        background: #0a0a0a;
        padding: 20px 30px;
        border-radius: 20px;
        box-shadow: inset 0 0 15px #0044cc, 0 0 30px #0044cc;
        text-align: center;
        color: white;
    }

    .panel h1 {
        font-size: 22px;
        margin-bottom: 20px;
        color: #00aaff;
        text-shadow: 0 0 10px #00aaff;
    }

    .option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 15px 0;
        padding: 12px;
        border-radius: 10px;
        background: #001f4d;
        box-shadow: 0 0 10px #0056ff, 0 0 20px #0056ff;
        font-size: 16px;
    }

    .option span {
        font-weight: bold;
        color: #00aaff;
    }

    .status {
        color: #ffffff;
        font-size: 14px;
    }

    .download-btn {
        display: block;
        width: 100%;
        margin-top: 25px;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(45deg, #0044cc, #00aaff);
        color: white;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        box-shadow: 0 0 15px #00aaff;
        cursor: pointer;
        transition: 0.3s;
        box-sizing: border-box;
        text-align: center;
    }

    .download-btn:hover {
        background: linear-gradient(45deg, #0056ff, #00ccff);
        box-shadow: 0 0 25px #00ccff;
    }
</style>
</head>
<body>

<div class="panel">
    <h1>DNS Profile Installation</h1>
    
    <div class="option">
        <span>DNS Status</span>
        <span class="status">Ready to Install</span>
    </div>

    <!-- ប៊ូតុងចុចដើម្បីទាញយកហ្វ៊ែល DNS Profile -->
    <a href="dns-profile.mobileconfig" class="download-btn" download>Install DNS Profile</a>
</div>

</body>
</html>
