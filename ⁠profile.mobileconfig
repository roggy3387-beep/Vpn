    <array>
        <dict>
            <key>PayloadDescription</key>
            <string>Custom DNS Configuration</string>
            <key>PayloadDisplayName</key>
            <string>DNS Profile</string>
            <key>PayloadIdentifier</key>
            <string>com.example.dns.profile</string>
